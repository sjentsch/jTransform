#' @importFrom jmvcore .
jtBatchConvertClass <- if (requireNamespace('jmvcore', quietly=TRUE)) R6::R6Class(
    "jtBatchConvertClass",
    inherit = jtBatchConvertBase,

    private = list(
        .crrCmd = "jmvReadWrite::convert_to_omv",
        .cnvDtF = NULL,
        .nonLtd = TRUE,

        .init = function() {
            # Update logging flags based on current options
            set_logflags(self$options$jxfLog)
            jinfo("jTransform: init phase started")
            if (private$.chkVar()) {
                # resize / prepare the output table (prpPvw in utils.R)
                prpPvw(crrTbl = self$results$pvwDta, dtaFrm = private$.cnvDtF[, -1], colFst = c(), nonLtd = private$.nonLtd)
            } else {
                # reset the output table (rstPvw in utils.R)
                rstPvw(crrTbl = self$results$pvwDta)
            }
            jinfo("jTransform: init phase ended")
        },

        .run = function() {
            # Update logging flags during the run phase
            set_logflags(self$options$jxfLog)
            jinfo("jTransform: run phase started")

            # assemble or reset data set / create information
            if (private$.chkVar()) {
                # if “Convert” was pressed (btnCnv ==  TRUE), start converting the files (one-by-one)
                if ("btnCnv" %in% names(self$options) && self$options$btnCnv) {
                    for (i in seq_len(nrow(private$.cnvDtF))) {
                        crrMsg <- jmvcore::format(.("Converting <strong>{}</strong> \u2192 <strong>{}</strong>",
                                                  private$.cnvDtF[i, "Original"], private$.cnvDtF[i, "Converted"])
                        self$results$dtaInf$setContent(crrMsg)
                        do.call(str2Fn(private$.crrCmd), list(fleInp = private$.cnvDtF[i, "fllNme"]))
                    }
                } else {
                    crrMsg <- jmvcore::format(.("Pressing the <strong>{}-button</strong> converts all data sets.",
                                              .("\"Convert\""))
                    self$results$dtaInf$setContent(crrMsg)
                    # if not, create a preview of the files to be converted; fllPvw in utils.R)
                    fllPvw(crrTbl = self$results$pvwDta, dtaFrm = private$.cnvDtF[, -1])
                }
                self$results$dtaInf$setVisible(TRUE)
            } else {
                self$results$dtaInf$setVisible(FALSE)
            }
            jinfo("jTransform: run phase ended")
        },

        .chkFle = function(crrFle = "") {
            if (!file.exists(crrFle) || !jmvReadWrite:::hasExt(crrFle, jmvReadWrite:::vldExt)) {
                jmvcore::reject(.("'{file}' doesn't exists or has an unsupported file type."), file = crrFle)
            }

            jmvReadWrite:::nrmFle(crrFle)
        },

        .chkVar = function() {
            if (!is.null(self$options$fleInp) && nzchar(self$options$fleInp)) {
                fleInp <- vapply(trimws(strsplit(self$options$fleInp, ";")[[1]]), private$.chkFle, character(1), USE.NAMES = FALSE)
                bseInp <- vapply(fleInp, basename, character(1))
                bseOut <- gsub(paste0("\\.", paste(jmvReadWrite:::vldExt, collapse="$|\\."), "$"), ".omv", bseInp)
                private$.cnvDtF <- data.frame(fllNme = fleInp, Original = bseInp, Converted = bseOut, row.names = seq_along(fleInp))
                return(TRUE)
            } else {
                private$.fleInp <- NULL
                return(FALSE)
            }
        }
        
    ),

    public = list(

        asSource = function() {
            if (private$.chkVar()) {
                paste(vapply(private$.cnvDtF[, "fllNme"], function(f) paste0(private$.crrCmd, "(fleInp = \"", f, "\")"), character(1)),
                      collapse = "\n")
            }
        }

    )
)
